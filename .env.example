# Environment variables are read from the process; .env is not loaded automatically.
TUIK_TIMEOUT_SECONDS=20
TUIK_ATTEMPTS=3
TUIK_MIN_INTERVAL_SECONDS=0.5
TUIK_DOWNLOAD_INTERVAL_SECONDS=6
TUIK_MAX_RESPONSE_BYTES=10485760

# Optional local search stack; these settings are reserved for the future backend.
# Leave URL unset or blank for the existing live-only MCP tools.
# TUIK_OPENSEARCH_URL=http://localhost:9200
# TUIK_OPENSEARCH_INDEX=tuik-resources
